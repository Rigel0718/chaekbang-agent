# docker compose (db 서비스)
POSTGRES_USER=chaekbang
POSTGRES_PASSWORD=chaekbang
POSTGRES_DB=chaekbang
POSTGRES_PORT=5432

# 앱
DATABASE_URL=postgresql+asyncpg://chaekbang:chaekbang@localhost:5432/chaekbang
# 테스트 (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://chaekbang:chaekbang@localhost:5432/chaekbang_test

# 인증 토큰 만료 시간 (시간)
ADMIN_TOKEN_HOURS=12
KIOSK_TOKEN_HOURS=720
# 대출일·연체 판단 기준 시간대
LIBRARY_TIMEZONE=Asia/Seoul
# 비밀번호 해시 비용 (scrypt N). 운영에서는 기본값을 쓴다.
PASSWORD_SCRYPT_N=16384

# YES24_API_KEY
YES24_API_KEY=

# 시드 계정 비밀번호 (개발용 값. 8자 이상)
SEED_ADMIN_PASSWORD=dev-admin-pass
SEED_KIOSK_PASSWORD=dev-kiosk-pass
