# docker compose (db 서비스)
POSTGRES_USER=chaekbang
POSTGRES_PASSWORD=chaekbang
POSTGRES_DB=chaekbang
POSTGRES_PORT=5432

# 앱
DATABASE_URL=postgresql+asyncpg://chaekbang:chaekbang@localhost:5432/chaekbang
# 테스트 (pytest)
TEST_DATABASE_URL=postgresql+asyncpg://chaekbang:chaekbang@localhost:5432/chaekbang_test

# 인증 토큰 만료 시간 (시간)
ADMIN_TOKEN_HOURS=12
KIOSK_TOKEN_HOURS=720
# 대출일·연체 판단 기준 시간대
LIBRARY_TIMEZONE=Asia/Seoul
# 비밀번호 해시 비용 (scrypt N). 운영에서는 기본값을 쓴다.
PASSWORD_SCRYPT_N=16384

# YES24_API_KEY
YES24_API_KEY=

# 도서관 정보 나루 API 키
LIBRARY_BIGDATA_KEY=

KAKAO_REST_API_KEY=

# LLM (OpenAI). 모델별 가격은 app/core/config.py의 LLM_PRICES를 본다.
OPENAI_API_KEY=
LLM_MODEL=gpt-6-luna
LLM_EFFORT=low
# 추론과 출력을 합친 상한
LLM_MAX_TOKENS=25000
LLM_TIMEOUT_SECONDS=60

# 시드 계정 비밀번호 (개발용 값. 8자 이상)
SEED_ADMIN_PASSWORD=dev-admin-pass
SEED_KIOSK_PASSWORD=dev-kiosk-pass

# AI 사서 대화. 무입력 시간(분)이 지나면 세션이 끝나고 메시지를 지운다.
LIBRARIAN_SESSION_IDLE_MINUTES=5
LIBRARIAN_MAX_TURNS=20
LIBRARIAN_DAILY_RUN_LIMIT=500

# 로컬 임베딩 서버(TEI): docker compose --profile embedding up -d embedder
# 모델(약 2.3GB)은 처음 띄울 때 한 번 내려받는다. 소개글은 이 컨테이너 밖으로 나가지 않는다.
EMBEDDING_PORT=8090
EMBEDDING_BASE_URL=http://localhost:8090
EMBEDDING_MODEL=dragonkue/snowflake-arctic-embed-l-v2.0-ko
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=600
